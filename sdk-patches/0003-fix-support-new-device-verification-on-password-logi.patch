From 7c4239a0d7a5be032ddf339f074176093e30d9ec Mon Sep 17 00:00:00 2001
From: jx <jixiang@fydeos.io>
Date: Thu, 27 Aug 2026 12:40:07 +0800
Subject: [PATCH 3/3] fix: support new-device verification on password login

---
 .../api/request/password_token_request.rs     | 11 ++++++++
 .../api/response/identity_token_response.rs   | 11 +++++++-
 crates/bitwarden-core/src/auth/login/mod.rs   | 10 +++++++
 .../bitwarden-core/src/auth/login/password.rs | 28 ++++++++++++++++---
 crates/bitwarden-core/src/client/builder.rs   |  7 ++++-
 crates/bitwarden-core/src/client/internal.rs  |  9 ++++++
 crates/bw/src/auth/login.rs                   |  2 ++
 crates/bw/src/main.rs                         |  1 +
 8 files changed, 73 insertions(+), 6 deletions(-)

diff --git a/crates/bitwarden-core/src/auth/api/request/password_token_request.rs b/crates/bitwarden-core/src/auth/api/request/password_token_request.rs
index 11ffaead..8c0f8287 100644
--- a/crates/bitwarden-core/src/auth/api/request/password_token_request.rs
+++ b/crates/bitwarden-core/src/auth/api/request/password_token_request.rs
@@ -32,6 +32,15 @@ pub(crate) struct PasswordTokenRequest {
     two_factor_provider: Option<TwoFactorProvider>,
     #[serde(rename = "twoFactorRemember")]
     two_factor_remember: Option<bool>,
+
+    // Phi patch: the one-time code the server emails when it does not
+    // recognize `deviceIdentifier` and the account has new-device login
+    // protection on. Without it that login is unanswerable: identity replies
+    // `invalid_grant` / "new device verification required" forever, because a
+    // device only becomes known after a token grant it can never obtain.
+    // `None` on the first attempt (which is what triggers the email).
+    #[serde(rename = "newDeviceOtp")]
+    new_device_otp: Option<String>,
 }
 
 impl PasswordTokenRequest {
@@ -41,6 +50,7 @@ impl PasswordTokenRequest {
         device_type: DeviceType,
         device_identifier: &str,
         two_factor: &Option<TwoFactorRequest>,
+        new_device_otp: Option<&str>,
     ) -> Self {
         let tf = two_factor.as_ref();
         let obj = Self {
@@ -55,6 +65,7 @@ impl PasswordTokenRequest {
             two_factor_token: tf.map(|t| t.token.to_owned()),
             two_factor_provider: tf.map(|t| t.provider.clone()),
             two_factor_remember: tf.map(|t| t.remember),
+            new_device_otp: new_device_otp.map(str::to_owned),
         };
         debug!(?obj, "initializing");
         obj
diff --git a/crates/bitwarden-core/src/auth/api/response/identity_token_response.rs b/crates/bitwarden-core/src/auth/api/response/identity_token_response.rs
index 4e620c16..3e7bd563 100644
--- a/crates/bitwarden-core/src/auth/api/response/identity_token_response.rs
+++ b/crates/bitwarden-core/src/auth/api/response/identity_token_response.rs
@@ -33,7 +33,16 @@ pub(crate) fn parse_identity_response(
     } else if let Ok(r) = serde_json::from_str::<IdentityTwoFactorResponse>(&response) {
         Ok(IdentityTokenResponse::TwoFactorRequired(Box::new(r)))
     } else if let Ok(r) = serde_json::from_str::<IdentityTokenFailResponse>(&response) {
-        Err(LoginError::IdentityFail(r))
+        // Phi patch: new-device login protection arrives as a plain
+        // `invalid_grant` whose only distinguishing mark is the error model
+        // message (the same string Bitwarden's own clients match on). Give it
+        // a typed error so callers can ask for the emailed code rather than
+        // dead-ending on "Error parsing Identity response: ...".
+        Err(match r.error_model.message.trim() {
+            "new device verification required" => LoginError::NewDeviceVerificationRequired,
+            "invalid new device otp" => LoginError::InvalidNewDeviceOtp,
+            _ => LoginError::IdentityFail(r),
+        })
     } else {
         Err(ApiError::ResponseContent {
             status,
diff --git a/crates/bitwarden-core/src/auth/login/mod.rs b/crates/bitwarden-core/src/auth/login/mod.rs
index 9e02d5df..55a35401 100644
--- a/crates/bitwarden-core/src/auth/login/mod.rs
+++ b/crates/bitwarden-core/src/auth/login/mod.rs
@@ -64,6 +64,16 @@ pub enum LoginError {
     #[error("Error parsing Identity response: {0}")]
     IdentityFail(crate::auth::api::response::IdentityTokenFailResponse),
 
+    // Phi patch: new-device login protection, split out of `IdentityFail` so
+    // callers can drive the verification UI instead of showing the server's
+    // raw sentence. The server has emailed a one-time code; retry the login
+    // with it in `PasswordLoginRequest::new_device_otp`.
+    #[error("New device verification required")]
+    NewDeviceVerificationRequired,
+    // Phi patch: the retry above carried a code the server rejected.
+    #[error("Invalid new device verification code")]
+    InvalidNewDeviceOtp,
+
     #[error("The state file could not be read")]
     InvalidStateFile,
     #[error("Invalid organization id")]
diff --git a/crates/bitwarden-core/src/auth/login/password.rs b/crates/bitwarden-core/src/auth/login/password.rs
index 5df202d4..bcbe8db2 100644
--- a/crates/bitwarden-core/src/auth/login/password.rs
+++ b/crates/bitwarden-core/src/auth/login/password.rs
@@ -88,15 +88,29 @@ async fn request_identity_tokens(
     input: &PasswordLoginRequest,
     password_hash: &str,
 ) -> Result<IdentityTokenResponse, LoginError> {
-    use crate::DeviceType;
-
     let config = client.internal.get_api_configurations();
+
+    // Phi patch: send this client's real device identity instead of upstream's
+    // hardcoded `DeviceType::ChromeBrowser` + constant UUID. The server keys
+    // known-device tracking (and therefore new-device verification) on the
+    // `deviceIdentifier` in this body, NOT on the `Device-Identifier` header
+    // the builder already sends — so with the constant, every consumer of this
+    // SDK shared one device record and `ClientSettings::device_identifier` was
+    // inert. `DEVICE_IDENTIFIER_FALLBACK` keeps callers that set no identifier
+    // on upstream's exact wire value.
+    const DEVICE_IDENTIFIER_FALLBACK: &str = "b86dd6ab-4265-4ddf-a7f1-eb28d5677f33";
+    let device_identifier = config
+        .device_identifier
+        .as_deref()
+        .unwrap_or(DEVICE_IDENTIFIER_FALLBACK);
+
     PasswordTokenRequest::new(
         &input.email,
         password_hash,
-        DeviceType::ChromeBrowser,
-        "b86dd6ab-4265-4ddf-a7f1-eb28d5677f33",
+        config.device_type,
+        device_identifier,
         &input.two_factor,
+        input.new_device_otp.as_deref(),
     )
     .send(&config.identity_config)
     .await
@@ -113,6 +127,12 @@ pub struct PasswordLoginRequest {
     pub password: String,
     /// Two-factor authentication
     pub two_factor: Option<TwoFactorRequest>,
+    // Phi patch: the one-time code emailed by new-device login protection.
+    // `None` on the first attempt; a login that fails with
+    // [`LoginError::NewDeviceVerificationRequired`] is retried with the code
+    // the user received.
+    #[allow(missing_docs)]
+    pub new_device_otp: Option<String>,
 }
 
 #[allow(missing_docs)]
diff --git a/crates/bitwarden-core/src/client/builder.rs b/crates/bitwarden-core/src/client/builder.rs
index 029b2fb9..04735d6c 100644
--- a/crates/bitwarden-core/src/client/builder.rs
+++ b/crates/bitwarden-core/src/client/builder.rs
@@ -135,7 +135,12 @@ impl ClientBuilder {
             internal: Arc::new(InternalClient {
                 user_id: OnceLock::new(),
                 token_handler: self.token_handler,
-                api_configurations: ApiConfigurations::new(identity, api, settings.device_type),
+                api_configurations: ApiConfigurations::new(
+                    identity,
+                    api,
+                    settings.device_type,
+                    settings.device_identifier,
+                ),
                 external_http_client,
                 key_store,
                 #[cfg(feature = "internal")]
diff --git a/crates/bitwarden-core/src/client/internal.rs b/crates/bitwarden-core/src/client/internal.rs
index 54cd748f..837ae130 100644
--- a/crates/bitwarden-core/src/client/internal.rs
+++ b/crates/bitwarden-core/src/client/internal.rs
@@ -44,6 +44,12 @@ pub struct ApiConfigurations {
     pub identity_config: bitwarden_api_identity::Configuration,
     pub api_config: bitwarden_api_api::Configuration,
     pub device_type: DeviceType,
+    // Phi patch: `ClientSettings::device_identifier`, kept here so login
+    // requests can put this install's own identifier in the token body (see
+    // `auth::login::password::request_identity_tokens`). Previously it reached
+    // the network only as a header, which the identity endpoint ignores for
+    // device tracking.
+    pub device_identifier: Option<String>,
 }
 
 impl std::fmt::Debug for ApiConfigurations {
@@ -59,6 +65,7 @@ impl ApiConfigurations {
         identity_config: bitwarden_api_identity::Configuration,
         api_config: bitwarden_api_api::Configuration,
         device_type: DeviceType,
+        device_identifier: Option<String>,
     ) -> Arc<Self> {
         let identity = Arc::new(identity_config.clone());
         let api = Arc::new(api_config.clone());
@@ -70,6 +77,7 @@ impl ApiConfigurations {
             identity_config,
             api_config,
             device_type,
+            device_identifier,
         })
     }
 
@@ -89,6 +97,7 @@ impl ApiConfigurations {
             api_config: dummy_config.clone(),
             identity_config: dummy_config,
             device_type: DeviceType::SDK,
+            device_identifier: None,
         }
     }
 
