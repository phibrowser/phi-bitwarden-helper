From bc0e30b48e9b48761058e5c8a46a76b4fff0a337 Mon Sep 17 00:00:00 2001
From: Xiang Ji <xj@openfyde.io>
Date: Tue, 21 Jul 2026 23:47:45 +0800
Subject: [PATCH] fix: default resetMasterPassword in identity success response
 (server stopped sending it)

---
 .../src/auth/api/response/identity_success_response.rs   | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/crates/bitwarden-core/src/auth/api/response/identity_success_response.rs b/crates/bitwarden-core/src/auth/api/response/identity_success_response.rs
index 3283b8c9..e89bf9ea 100644
--- a/crates/bitwarden-core/src/auth/api/response/identity_success_response.rs
+++ b/crates/bitwarden-core/src/auth/api/response/identity_success_response.rs
@@ -24,7 +24,14 @@ pub(crate) struct IdentityTokenSuccessResponse {
     #[serde(rename = "kdfIterations", alias = "KdfIterations")]
     kdf_iterations: NonZeroU32,
 
-    #[serde(rename = "resetMasterPassword", alias = "ResetMasterPassword")]
+    // Phi patch: the 2026 server no longer sends this field, which made the
+    // whole success-response deserialize fail and fall through to `Refreshed`
+    // (→ `unreachable!` panic in `PasswordLoginResponse::process_response`).
+    #[serde(
+        default,
+        rename = "resetMasterPassword",
+        alias = "ResetMasterPassword"
+    )]
     pub reset_master_password: bool,
     #[serde(rename = "forcePasswordReset", alias = "ForcePasswordReset")]
     pub force_password_reset: bool,
-- 
2.50.1 (Apple Git-155)

